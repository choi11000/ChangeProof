# Runtime mode: development, test, or production
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true
# Browser-visible API origin used by the Next.js application
NEXT_PUBLIC_API_URL=http://localhost:8000
# Main application database connection
DATABASE_URL=postgresql+psycopg://changeproof:changeproof@postgres:5432/changeproof
# Disposable database used by future migration validation jobs
SANDBOX_DATABASE_URL=postgresql+psycopg://changeproof:changeproof@sandbox-postgres:5432/changeproof_sandbox
# Set locally; never commit real credentials
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=1200
MAX_AI_EVIDENCE=30
MAX_AI_CHANGES=50
MAX_EVIDENCE_EXCERPT_CHARS=240
MAX_AI_WARNINGS=10
MAX_WARNING_CHARS=200
AI_CACHE_MAX_ENTRIES=256
AI_CACHE_TTL_SECONDS=3600
GITHUB_TOKEN=
GITHUB_PUBLIC_REPOSITORIES_ONLY=true
ANALYSIS_RATE_LIMIT=10
EXPERIMENT_RATE_LIMIT=6
PROOF_RATE_LIMIT=3
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=4096
TRUST_PROXY_HEADERS=false
MAX_CONCURRENT_SANDBOX_RUNS=2
REQUIRE_SANDBOX_TESTS=false
# Optional submission demo defaults. The button is hidden unless both are valid.
NEXT_PUBLIC_DEMO_REPOSITORY=
NEXT_PUBLIC_DEMO_PR=
